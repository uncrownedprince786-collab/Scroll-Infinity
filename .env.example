# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets.

# --- Database (required) ---
# Any PostgreSQL connection string (Neon recommended for serverless).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Site ---
# Canonical base URL, no trailing slash. Used for sitemap, canonical URLs, OG tags.
NEXT_PUBLIC_SITE_URL="https://scrollinfinityhq.vercel.app"

# --- Ingestion ---
# Contact URL or email embedded in the crawler User-Agent (Wikimedia asks for this).
SOURCE_USER_AGENT_CONTACT="https://scrollinfinityhq.vercel.app"
# Secret token protecting the admin re-ingest endpoint. Generate a random value.
INGEST_SECRET="change-me-to-a-long-random-string"

# --- Future adapters (not needed for the current milestone) ---
# Cloudflare R2 object storage for the raw archive — spec sec. 14
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Google Search Console API — spec sec. 26
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
# Bing Webmaster Tools (REST) — spec sec. 27
# BING_API_KEY=
